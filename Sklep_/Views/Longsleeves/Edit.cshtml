
@model Longsleeve

<form asp-action="Edit" method="post">
    <h1>Edycja: @Model.Color.GetDisplayName() @Model.Size</h1>
    <input asp-for="Id" type="hidden"/>
    <div class="mb-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" class="form-control"></input>
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="UnitCost" class="form-label">Koszt</label>
        <input asp-for="UnitCost" class="form-control"></input>
        <span asp-validation-for="UnitCost" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Zapisz</button>

</form>

