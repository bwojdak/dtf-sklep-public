@model Sklep_.ViewModel.LoginViewModel
<div class="text-danger">
    <div asp-validation-summary="ModelOnly"></div>
</div>
<form asp-action="Login" method="post">
    <div class="row g-1 mt-3" style="max-width: 400px;">
        <div class="col-md-12">
            <div class="card h-100">
                <div class="card-body mb-3">
                    <label asp-for="UserName" class="form-label">Login</label>
                    <input asp-for="UserName" class="form-control"></input>
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>
                <div class="card-body mb-3">
                    <label asp-for="Password" class="form-label">Hasło</label>
                    <input asp-for="Password" class="form-control mb-2"></input>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="card-body mb-3">
                    <button type="submit" class="btn btn-sm btn-success mb-2">Zaloguj się</button>
                </div>
            </div>
        </div>
    </div>
</form>