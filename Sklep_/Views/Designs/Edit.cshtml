
@model Design
<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden"></input>
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Nazwa</label>
        <input asp-for="Name" class="form-control"/>
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Type" class="form-label">Typ</label>
        <input asp-for="Type" class="form-control"/>
    </div>
    <div class="mb-3">
        <label asp-for="PrintCost" class="form-label">Koszt</label>
        <input asp-for="PrintCost" type="text" class="form-control"/>
        <span asp-validation-for="PrintCost" class="text-danger"></span>
    </div>
    <div class="mb-3"> 
        <label asp-for="Description" class="form-label">Opis</label>
        <input asp-for="Description" type="text" class="form-control"/>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label>Zdjęcie</label>
        <input type="file" name="image" class="form-control"/>
        
    </div>
    <div>
    @if (Model.ImgPath != null)
    {
        <img class="img-fluid" style="max-height: 400px" alt="@Model.Name" src="@Model.ImgPath"/>
    }
    </div>
    <button type="submit" class="btn btn-primary">Zapisz</button>
    
</form>